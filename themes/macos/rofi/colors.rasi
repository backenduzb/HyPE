* {
    mac-bg: #1e1e20;
    mac-bg-translucent: rgba(28,28,30,0.72);
    mac-menu-bg: rgba(28,28,30,0.94);
    mac-tooltip-bg: rgba(44,44,46,0.94);
    mac-surface: #2c2c2e;
    mac-surface-alt: #3a3a3c;
    mac-surface-hover: #48484a;
    mac-text: #f5f5f7;
    mac-text-dim: #a1a1a6;
    mac-text-muted: #8e8e93;
    mac-accent: #ffffff;
    mac-accent-hover: #cccccc;
    mac-accent-inactive: #3a6f9f;
    mac-on-accent: #1e1e20;
    mac-red: #ff453a;
    mac-yellow: #ffd60a;
    mac-green: #32d74b;
    mac-blue: #0a84ff;
    mac-cyan: #64d2ff;
    mac-purple: #bf5af2;
    mac-border: rgba(255,255,255,0.12);
    mac-separator: rgba(255,255,255,0.08);
    mac-shadow: rgba(0,0,0,0.45);
    mac-bar-border: rgba(255,255,255,0.08);
    mac-icon-muted: rgba(245,245,247,0.42);
    mac-icon-hover: rgba(245,245,247,0.85);
    mac-entry-bg: rgba(255,255,255,0.06);
    mac-button-shadow: rgba(0,0,0,0.25);
    mac-focus-ring: rgba(10,132,255,0.25);
    mac-control-bg: rgba(255,255,255,0.08);
    mac-control-disabled: rgba(255,255,255,0.05);
    mac-switch-bg: rgba(255,255,255,0.16);
    mac-progress-bg: rgba(255,255,255,0.10);
    mac-scrollbar: rgba(255,255,255,0.25);
    mac-scrollbar-hover: rgba(255,255,255,0.40);
    mac-sidebar: rgba(30,30,32,0.72);
}
