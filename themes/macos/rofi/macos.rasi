@import "colors.rasi"
@import "icon-theme.rasi"
@import "banner.rasi"

configuration {
    modes: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    top-level: true;
    steal-focus: true;
    markup-rows: true;
    highlight: "bold";

    kb-remove-to-eol: "";
    kb-element-next: "";
    kb-element-prev: "";

    kb-row-up: "Up,Control+k,ISO_Left_Tab";
    kb-row-down: "Down,Control+j,Tab";
    kb-accept-entry: "Return,KP_Enter";
}

* {
    font: "SF Pro Text 10";
    background-color: transparent;
    text-color: @mac-text;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    anchor: center;
    width: 980px;
    height: 500px;
    border-radius: 20px;
    background-color: @mac-bg-translucent;
    border: 0px;
    border-color: @mac-border;
    padding: 0px;
}

mainbox {
    border: 0px;
    orientation: horizontal;
    children: [ banner, contentbox ];
    spacing: 0px;
    background-color: transparent;
}

banner {
    width: 480px;
    height: 500px;
    expand: false;
    background-color: transparent;
}

contentbox {
    orientation: vertical;
    children: [ inputbar, listview ];
    background-color: transparent;
    padding: 20px;
    spacing: 0px;
}

inputbar {
    width: 0px;
    height: 0px;
    padding: 0px;
    margin: 0px;
    border: 0px;
    background-color: transparent;
    children: [ entry ];
}

entry {
    width: 0px;
    height: 0px;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
    text-color: transparent;
    placeholder: "";
    placeholder-color: transparent;
}

listview {
    layout: vertical;
    lines: 9;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
    background-color: transparent;
    dynamic: true;
    border: 0px;
}

element {
    orientation: horizontal;
    padding: 8px 14px;
    border-radius: 12px;
    spacing: 12px;
    background-color: transparent;
    children: [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @mac-text-dim;
}

element selected.normal,
element selected.active {
    background-color: @mac-surface-hover;
    text-color: @mac-text;
}

element-icon {
    size: 42px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    text-color: inherit;
    font: "SF Pro Text 10";
    highlight: bold;
}
