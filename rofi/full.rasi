configuration {
    modes: "drun";
    show-icons: true;
    icon-theme: "WhiteSur-dark";
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    top-level: true;
    steal-focus: true;

    kb-remove-to-eol: "";
    kb-element-next: "";
    kb-element-prev: "";
    border-radius: 20px;


    kb-row-up: "Up,Control+k,ISO_Left_Tab";
    kb-row-down: "Down,Control+j,Tab";
    kb-accept-entry: "Return,KP_Enter";
}

* {
    font: "SF Pro Text Bold 10";
    background-color: transparent;
    text-color: #f5f5f5;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    anchor: center;
    width: 980px;
    height: 500px;
    border-radius: 20px;
    background-color: #00000098;
    border: 0px;
    border-color: #ffffff10;
    padding: 0px;
}

mainbox {
    border: 0px;
    orientation: horizontal;
    children: [ banner, listview ];
    spacing: 0px;
    background-color: transparent;
}

banner {
    width: 480px;
    height: 500px;
    expand: false;
    background-color: transparent;
    background-image: url("/home/vic/Projects/hycon/assets/wallpapers/space.jpg", height);
}

listview {
    layout: vertical;
    lines: 9;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
    background-color: transparent;
    dynamic: true;
    padding: 20px;
    border: 0px;
}

element {
    orientation: horizontal;
    padding: 8px 14px;
    border-radius: 12px;
    spacing: 12px;
    background-color: transparent;
    children: [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: #a0a0a0;
}

element selected.normal,
element selected.active {
    background-color: #acacac90;
    text-color: #ffffff;
}

element-icon {
    size: 42px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    text-color: inherit;
    font: "SF Pro Text Mono 10";
}
