{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,

    "modules-left": ["custom/arch", "custom/settings", "hyprland/workspaces"],

    "modules-center": ["group/hardware"],

    "modules-right": ["tray", "backlight", "pulseaudio", "custom/power-safe", "battery", "clock"],

    "custom/arch": {
        "format": "󰣇",
        "tooltip": true,
        "tooltip-format": "Power Menu",
        "on-click": "pkill wlogout || wlogout -b 3 -l ${HYCON_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}}/wlogout/layout -C ${HYCON_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}}/wlogout/style.css",
        "cursor": true
    },

    "custom/settings": {
        "format": "󰒓",
        "tooltip": false,
        "on-click": "${HYCON_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}}/waybar/scripts/settings-menu.py",
        "cursor": true
    },

    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "temperature",
            "custom/gpu-icon",
            "custom/gpu-temp",
        ],
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": true,
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 2,
        "tooltip": true,
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}°C",
        "tooltip": true,
    },

    "custom/gpu-icon": {
        "exec": "$HOME/.config/waybar/scripts/gpu.sh icon",
        "return-type": "json",
        "interval": 3,
        "signal": 8,
        "tooltip": true,
        "cursor": true,
        "on-click": "$HOME/.config/waybar/scripts/gpu.sh toggle",
    },

    "custom/gpu-temp": {
        "exec": "$HOME/.config/waybar/scripts/gpu.sh temp",
        "return-type": "json",
        "interval": 3,
        "signal": 8,
        "tooltip": true,
        "cursor": true,
        "on-click": "$HOME/.config/waybar/scripts/gpu.sh toggle",
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰮯",
            "default": "󰊠",
            "empty": "󰑊",
        },
        "persistent-workspaces": {
            "*": 5,
        },
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10,
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "interval": 1,
        "tooltip-format": "Brightness: {percent}%",
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 0%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"],
        },
        "tooltip-format": "Volume: {volume}%",
        "on-click": "pavucontrol",
    },

    // Power Safe: TLP + cpupower CPU limit (settings in waybar/power-safe.conf)
    "custom/power-safe": {
        "exec": "$HOME/.config/waybar/scripts/power-safe.sh status",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "tooltip": true,
        "cursor": true,
        "on-click": "$HOME/.config/waybar/scripts/power-safe.sh toggle",
        "on-click-right": "$HOME/.config/waybar/scripts/power-safe.sh details",
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󱈑"],
        "tooltip-format": "Battery: {capacity}%",
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname} ({ipaddr})",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor",
    },
}
