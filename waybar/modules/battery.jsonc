{
  "battery": {
    "interval": 10,

    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󰁹 100%",

    "states": {
      "warning": 30,
      "critical": 15
    },

    "format-icons": [
      "󰂎",  
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂀",
      "󰂂",
      "󰂂",
      "󰂂",
      "󰁹"   
    ]
  }
}
