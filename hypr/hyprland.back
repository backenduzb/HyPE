local configHome = os.getenv("HYCON_DIR")
    or os.getenv("XDG_CONFIG_HOME")
    or ((os.getenv("HOME") or "") .. "/.config")

local waybarConfig = configHome .. "/waybar/config.jsonc"
local waybarStyle = configHome .. "/waybar/style.css"
local dunstConfig = configHome .. "/dunst/dunstrc"

if os.getenv("HYCON_NESTED") == "1" then
    hl.monitor({
        output = "",
        mode = "1920x1080",
        position = "auto",
        scale = 1,
    })
end

if os.getenv("HYCON_DEBUG") == "1" then
    hl.config({
        debug = {
            enable_stdout_logs = true,
        },
    })
end

hl.config({
    general = {
        gaps_in = 5,
        gaps_out = 9,
        border_size = 2,
        resize_on_border = true,
        allow_tearing = false,
    },

    decoration = {
        rounding = 12,
        active_opacity = 1.0,
        inactive_opacity = 0.94,

        shadow = {
            enabled = true,
            range = 10,
            render_power = 2,
            color = "rgba(00000035)",
        },

        blur = {
            enabled = true,
            size = 5,
            passes = 1,
            new_optimizations = true,
            popups = false,
            special = false,
            xray = true,
            noise = 0.01,
            vibrancy = 0.12,
        },
    },

    input = {
        follow_mouse = 1,
        sensitivity = 0,
    },

    misc = {
        vrr = 0,
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
    },

    animations = {
        enabled = true,
    },
})

hl.curve("smooth", {
    type = "bezier",
    points = {
        { 0.16, 1.0 },
        { 0.3, 1.0 },
    },
})

hl.animation({
    leaf = "windows",
    enabled = true,
    speed = 5,
    bezier = "smooth",
    style = "popin 95%",
})

hl.animation({
    leaf = "windowsOut",
    enabled = true,
    speed = 4,
    bezier = "smooth",
    style = "popin 90%",
})

hl.animation({
    leaf = "workspaces",
    enabled = true,
    speed = 5,
    bezier = "smooth",
    style = "slide",
})

hl.on("hyprland.start", function()
    hl.exec_cmd(string.format('waybar -c "%s" -s "%s"', waybarConfig, waybarStyle))
    hl.exec_cmd(string.format('dunst -conf "%s"', dunstConfig))
    hl.exec_cmd("command -v hyprpaper >/dev/null 2>&1 && hyprpaper")
    hl.exec_cmd("command -v hyprpolkitagent >/dev/null 2>&1 && hyprpolkitagent")
end)

hl.layer_rule({
    match = { namespace = "waybar" },
    blur = true,
    xray = true,
})